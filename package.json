{
  "name": "platform-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:uc": "pnpm --filter uc dev",
    "dev:flow": "pnpm --filter flow dev",
    "dev:portal": "pnpm --filter portal dev",
    "build": "turbo run build",
    "lint": "turbo run lint:oxlint",
    "lint:fix": "turbo run lint:oxlint && turbo run lint:fix",
    "lint:all": "turbo run lint:all",
    "lint:eslint": "turbo run lint",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "fix": "pnpm lint:fix && pnpm format:fix"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "oxlint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.24.0"
  }
}
