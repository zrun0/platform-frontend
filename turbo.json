{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [
    ".env*",
    "eslint.config.js",
    ".prettierrc",
    ".prettierignore",
    "tsconfig.base.json",
    ".oxlintrc.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"],
      "env": ["VITE_*"]
    },
    "format": {
      "outputs": []
    },
    "format:fix": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "lint:oxlint": {
      "outputs": []
    },
    "lint:all": {
      "dependsOn": ["^lint:oxlint", "^lint"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    }
  }
}
