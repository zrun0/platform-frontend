{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y"],
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/*.generated.*",
    "**/*.d.ts",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.nyc_output/**",
    ".vscode/**",
    ".idea/**",
    "**/.env.*"
  ]
}
